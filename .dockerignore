# Keep secrets, local state, and what the image installs itself out of the build.
.git
.github
.claude
.idea
.vscode

.env
.env.*
!.env.example

node_modules
vendor
tests
dashboard.html
.phpunit.cache
.phpunit.result.cache

# Files cached for local development name packages that are not installed in production.
bootstrap/cache/*
!bootstrap/cache/.gitignore

storage/app/private/*
!storage/app/private/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore

public/build
public/hot
public/storage
